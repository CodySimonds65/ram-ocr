<Window x:Class="RamOcr.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RAM OCR" Height="680" Width="1040" Background="#090B10" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen">
  <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="14" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="＋  New trigger" Click="NewTrigger_Click" Background="#7C5CFC" Foreground="White" Padding="12,8"/><Button Content="Pause all" Click="Pause_Click" Margin="0,8,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="12,8"/></StackPanel><StackPanel><TextBlock Text="TRIGGERS" FontSize="11" Foreground="#929AAD" FontWeight="SemiBold"/><ListBox x:Name="TriggerList" DisplayMemberPath="Name" SelectionChanged="TriggerList_SelectionChanged" Margin="0,10,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Column="2" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Screen trigger dashboard" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Watch account-relative regions without activating Roblox or storing frames." Foreground="#929AAD" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,14"><Button Content="Test now" Click="Test_Click" Background="#7C5CFC" Foreground="White" Padding="16,8"/><Button Content="Save trigger" Click="Save_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="16,8"/></StackPanel><Border Grid.Row="2" Background="#171B24" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="TRIGGER EDITOR" Foreground="#929AAD" FontSize="11"/><TextBlock x:Name="EditorText" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Grid.Row="3" x:Name="StatusText" Text="Background-safe mode: no focus APIs are used." Foreground="#929AAD" Margin="0,14,0,0"/></Grid></Border>
  </Grid>
</Window>
